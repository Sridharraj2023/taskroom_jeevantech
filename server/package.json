{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx --env-file-if-exists=../.env src/setup.ts migrate",
    "admin": "tsx --env-file-if-exists=../.env src/setup.ts admin",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.1.0",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.1.0",
    "cookie-parser": "^1.4.7"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "tsx": "^4.20.5",
    "@types/node": "^24.3.0",
    "@types/express": "^5.0.3",
    "@types/pg": "^8.15.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/cookie-parser": "^1.4.9",
    "supertest": "^7.1.4",
    "@types/supertest": "^6.0.3",
    "@electric-sql/pglite": "^0.3.10"
  }
}
